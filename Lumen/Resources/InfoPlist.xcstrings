{
  "sourceLanguage": "en",
  "strings": {
    "CFBundleDisplayName": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lumen"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lumen"
          }
        }
      }
    },
    "NSAlarmKitUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you ask, Lumen sets timers and alarms. It asks before it sets an alarm."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När du ber om det ställer Lumen timers och larm. Lumen frågar innan den ställer ett larm."
          }
        }
      }
    },
    "NSCalendarsFullAccessUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you ask, Lumen adds events to your calendar and tells you what is in it. It always asks before it adds something."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När du ber om det lägger Lumen in händelser i din kalender och berättar vad som finns i den. Lumen frågar alltid innan den lägger in något."
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take a photo of the page you are studying, so Lumen can quiz you on it. The text is read on the iPhone; the photo is not saved."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fota sidan du pluggar på, så förhör Lumen dig på den. Texten läses på telefonen, och bilden sparas inte."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lumen listens to the room through your microphone to transcribe speech and answer questions in your AirPods. Audio is streamed for transcription and is not saved."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lumen lyssnar genom mikrofonen för att skriva ut tal och svara på frågor i dina AirPods. Ljudet strömmas för utskrift och sparas inte."
          }
        }
      }
    },
    "NSRemindersFullAccessUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you ask, Lumen adds reminders. It always asks before it adds one."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När du ber om det lägger Lumen in påminnelser. Lumen frågar alltid innan den lägger in en."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lumen can use the iPhone's own speech recognition, as a fallback or when you switch off cloud recognition in Settings."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lumen kan använda iPhonens egen taligenkänning, som reserv eller när du stänger av molnet i Inställningar."
          }
        }
      }
    }
  },
  "version": "1.0"
}
