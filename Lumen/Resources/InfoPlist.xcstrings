{
  "sourceLanguage": "en",
  "strings": {
    "CFBundleDisplayName": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Earmind"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Earmind"
          }
        }
      }
    },
    "NSAlarmKitUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you ask, Earmind sets timers and alarms. It asks before it sets an alarm."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När du ber om det ställer Earmind timers och larm. Earmind frågar innan den ställer ett larm."
          }
        }
      }
    },
    "NSCalendarsFullAccessUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you ask, Earmind adds events to your calendar and tells you what is in it. It always asks before it adds something."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När du ber om det lägger Earmind in händelser i din kalender och berättar vad som finns i den. Earmind frågar alltid innan den lägger in något."
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take a photo of the page you are studying, so Earmind can quiz you on it. The text is read on the iPhone; the photo is not saved."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fota sidan du pluggar på, så förhör Earmind dig på den. Texten läses på telefonen, och bilden sparas inte."
          }
        }
      }
    },
    "NSContactsUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you say \"Lumen, call Mum\", Earmind looks the name up in your contacts to find the number. Nothing from your contacts is sent anywhere."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När du säger ”Lumen, ring mamma” letar Earmind upp namnet i dina kontakter för att hitta numret. Inget från kontakterna skickas någonstans."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Earmind listens to the room through your microphone to transcribe speech and answer questions in your AirPods. Audio becomes text and is not saved by Earmind. Sleep mode keeps its clips only on your phone."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Earmind lyssnar genom mikrofonen för att skriva ut tal och svara på frågor i dina AirPods. Ljudet blir text och sparas inte av Earmind. Sömnläget sparar klippen bara på din telefon."
          }
        }
      }
    },
    "NSRemindersFullAccessUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you ask, Earmind adds reminders. It always asks before it adds one."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När du ber om det lägger Earmind in påminnelser. Earmind frågar alltid innan den lägger in en."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Earmind can use the iPhone's own speech recognition, as a fallback or when you switch off cloud recognition in Settings."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Earmind kan använda iPhonens egen taligenkänning, som reserv eller när du stänger av molnet i Inställningar."
          }
        }
      }
    }
  },
  "version": "1.0"
}
