{
  "sourceLanguage": "en",
  "strings": {
    "CFBundleDisplayName": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lumen"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lumen"
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take a photo of the page you are studying, so Lumen can quiz you on it. The text is read on the iPhone; the photo is not saved."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fota sidan du pluggar på, så förhör Lumen dig på den. Texten läses på telefonen, och bilden sparas inte."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lumen listens to the room through your microphone to transcribe speech and answer questions in your AirPods. Audio is streamed for transcription and is not saved."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lumen lyssnar genom mikrofonen för att skriva ut tal och svara på frågor i dina AirPods. Ljudet strömmas för utskrift och sparas inte."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lumen can use the iPhone's own speech recognition, as a fallback or when you switch off cloud recognition in Settings."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lumen kan använda iPhonens egen taligenkänning, som reserv eller när du stänger av molnet i Inställningar."
          }
        }
      }
    }
  },
  "version": "1.0"
}
