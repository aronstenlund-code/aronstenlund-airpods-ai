    "A call or another app interrupted the session.": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett samtal eller en annan app avbröt sessionen."
          }
        }
      }
    },
    "A call or another app took the audio. Tap Resume to listen again.": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett samtal eller en annan app tog över ljudet. Tryck på Fortsätt för att lyssna igen."
