    "Texten räknas som en fråga per påbörjade 800 tecken, ungefär en tredjedel av en boksida.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "The text counts as one question per started 800 characters, about a third of a book page."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Texten räknas som en fråga per påbörjade 800 tecken, ungefär en tredjedel av en boksida."
          }
        }
      },
      "comment": "A157: English by Angela Fable, for Kelly's review (Ke86)."
    },
    "Texten skickas via EarMinds server till Claude från Anthropic, som tar fram svaret. Utan nät blir det inga svar.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "The text is sent through EarMind's server to Claude from Anthropic, which produces the answer. Without a connection there are no answers."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Texten skickas via EarMinds server till Claude från Anthropic, som tar fram svaret. Utan nät blir det inga svar."
          }
        }
      },
      "comment": "A157: English by Angela Fable, for Kelly's review (Ke86)."
    },
    "Texten spelas vidare.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
