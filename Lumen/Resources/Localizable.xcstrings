    },
    "Andra som pratar i rummet hörs svagare i AirPods. Deras tal skickas inte, så din fråga blir klar när du tystnar.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Others talking in the room sound fainter in your AirPods. Their speech isn't sent, so your question is done when you stop talking."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Andra som pratar i rummet hörs svagare i AirPods. Deras tal skickas inte, så din fråga blir klar när du tystnar."
