    },
    "Allt ljud medan EarMind lyssnar skickas till oss, också andras röster och bakgrundsljud. Det hjälper oss att höra om frågan uppfattades rätt.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "All audio while EarMind listens is sent to us, including other people's voices and background noise. It helps us hear whether the question was understood correctly."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Allt ljud medan EarMind lyssnar skickas till oss, också andras röster och bakgrundsljud. Det hjälper oss att höra om frågan uppfattades rätt."
          }
        }
      },
      "comment": "A157: English by Angela Fable, for Kelly's review (Ke86)."
    },
