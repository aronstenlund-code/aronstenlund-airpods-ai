    "Answers to questions appear here and are spoken in your AirPods.": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Svar på frågor visas här och läses upp i dina AirPods."
