    "Every mode is hands-free: EarMind listens for questions in the room. Higher sensitivity answers more, and more often by mistake. The text field is the fallback.": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla lägen är handsfree: EarMind lyssnar efter frågor i rummet. Högre känslighet svarar oftare, och oftare fel. Skrivrutan finns som reserv."
          }
        }
      }
    },
