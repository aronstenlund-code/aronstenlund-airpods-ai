{
  "sourceLanguage": "en",
  "strings": {
    "%@ is not available for on-device speech recognition on this iPhone. Switch language below.": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ finns inte för taligenkänning på den här telefonen. Byt språk nedan."
          }
        }
      }
    },
    "%@ · %lld answers · %lld lines": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %lld svar · %lld rader"
          }
        }
      }
    },
