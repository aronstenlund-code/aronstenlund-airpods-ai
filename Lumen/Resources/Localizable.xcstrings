    "EarMind gör inget med ljudet förrän du trycker Klar. Ljudet stannar på telefonen och raderas sedan; bara texten skickas.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "EarMind does nothing with the audio until you tap Done. The audio stays on the phone and is then deleted; only the text is sent."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "EarMind gör inget med ljudet förrän du trycker Klar. Ljudet stannar på telefonen och raderas sedan; bara texten skickas."
          }
        }
      },
      "comment": "A157: English by Angela Fable, for Kelly's review (Ke86)."
    },
    "EarMind gör provfrågor med A-svar.": {
      "extractionState": "manual",
      "localizations": {
