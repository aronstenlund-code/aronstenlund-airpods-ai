    "Practice: a friend asks, you get the outline of an answer, then feedback on yours. Use live support only where it is allowed and the others know, for example a mock interview.": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Övning: en kompis frågar, du får ett upplägg till svar och sedan återkoppling på ditt svar. Använd stöd live bara där det är tillåtet och de andra vet om det, till exempel vid en övningsintervju."
          }
        }
      }
    },
