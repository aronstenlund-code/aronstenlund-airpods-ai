      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lyssningen stoppas, sessionens transkription raderas och samtyckesskärmen visas igen."
          }
        }
      }
    },
