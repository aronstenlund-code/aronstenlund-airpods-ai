    "Ett tryck stoppar mikrofonen. Du kan ta tillbaka samtycket under Integritet och samtycke, och då visas den här sidan igen.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "One tap stops the microphone. You can withdraw your consent under Privacy and consent, and then this page is shown again."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett tryck stoppar mikrofonen. Du kan ta tillbaka samtycket under Integritet och samtycke, och då visas den här sidan igen."
          }
        }
      },
      "comment": "A157: English by Angela Fable, for Kelly's review (Ke86)."
    },
