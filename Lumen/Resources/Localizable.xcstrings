    " Brickan visar ”Testläge · ljud skickas” så länge ljud skickas.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": " The badge shows “Test mode · audio is sent” as long as audio is sent."
          }
        },
