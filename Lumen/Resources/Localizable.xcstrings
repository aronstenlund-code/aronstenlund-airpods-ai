    "Socker och syre bildas av koldioxid och vatten med hjälp av ljus.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sugar and oxygen are formed from carbon dioxide and water with the help of light."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Socker och syre bildas av koldioxid och vatten med hjälp av ljus."
