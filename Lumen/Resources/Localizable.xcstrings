    "\"Nästa låt\" och \"förra låten\" byter låt i Spotify när den är kopplad, annars i Apple Music. Annars: tryck två gånger på AirPods.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "\"Nästa låt\" and \"förra låten\" change song in Spotify when it is connected, otherwise in Apple Music. Otherwise: press twice on your AirPods."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Nästa låt\" och \"förra låten\" byter låt i Spotify när den är kopplad, annars i Apple Music. Annars: tryck två gånger på AirPods."
          }
        }
      },
      "comment": "A157: English by Angela Fable, for Kelly's review (Ke86)."
    },
    "\"Upprepa\", \"viska\", \"högre\", \"kortare\", \"snabbare\" och \"utveckla\" som hela meningen.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "\"Upprepa\", \"viska\", \"högre\", \"kortare\", \"snabbare\" and \"utveckla\" as the whole sentence."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Upprepa\", \"viska\", \"högre\", \"kortare\", \"snabbare\" och \"utveckla\" som hela meningen."
          }
        }
      },
      "comment": "A157: English by Angela Fable, for Kelly's review (Ke86)."
    },
