      },
      "comment": "A157: English by Angela Fable, for Kelly's review (Ke86)."
    },
    "Om dig": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "About you"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om dig"
          }
        }
      },
      "comment": "A157: English by Angela Fable, for Kelly's review (Ke86)."
    },
    "On: audio goes to ElevenLabs for the best recognition. Off: everything stays on this iPhone, with weaker recognition.": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "På: ljudet går till ElevenLabs för bäst igenkänning. Av: allt stannar på den här iPhonen, med sämre igenkänning."
          }
        }
      }
    },
    "One tap stops the microphone. You can withdraw this consent later under Privacy & consent; the consent screen then returns.": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett tryck stänger av mikrofonen. Du kan ta tillbaka ditt samtycke senare under Integritet och samtycke; då visas den här skärmen igen."
          }
        }
      }
    },
    "Options": {
