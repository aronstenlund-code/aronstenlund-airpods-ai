      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto"
          }
        }
      }
    },
    "Auto listens for questions in the room. Hold to ask gives the fewest false answers.": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto lyssnar efter frågor i rummet. Håll för att fråga ger minst felaktiga svar."
          }
        }
      }
    },
    "Auto-end after %lld min of silence": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Avsluta automatiskt efter %lld min tystnad"
          }
        }
      }
    },
    "Before you start": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Innan du börjar"
          }
        }
      }
    },
