    "EarMind kan påminna dig klockan %@ de dagar du inte har pluggat. Högst en gång om dagen.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "EarMind can remind you at %@ on days you haven't studied. At most once a day."
          }
        },
        "sv": {
