    "Obegränsat": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Unlimited"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Obegränsat"
          }
        }
      },
      "comment": "A157: English by Angela Fable, for Kelly's review (Ke86)."
    },
    "Off by default. When on, your own questions and EarMind's answers are uploaded without your name and kept for at most 12 months. New and edited questions in your quizzes are also sent, not linked to you, and deleted within 14 days. Other people's speech is never sent. Turning it off deletes what was shared.": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Avstängt från början. När det är på laddas dina egna frågor och EarMinds svar upp utan ditt namn och sparas högst 12 månader. Nya och ändrade frågor i dina prov skickas också, utan koppling till dig, och raderas inom 14 dagar. Andra personers tal skickas aldrig. Stänger du av raderas det som delats."
          }
        }
      }
    },
    "Okej": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "OK"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Okej"
          }
        }
      },
      "comment": "A157: English by Angela Fable, for Kelly's review (Ke86)."
    },
    "Okänd skärm: %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
