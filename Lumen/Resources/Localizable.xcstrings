    "Du: %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "You: %@"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du: %@"
          }
        }
      },
      "comment": "A157: English by Angela Fable, for Kelly's review (Ke86)."
    },
    "Då pratar EarMind på din nivå, hör dina ämnesord rätt och vet vad du ska öva på.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Then EarMind talks at your level, hears your subject words correctly and knows what you should practise."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Då pratar EarMind på din nivå, hör dina ämnesord rätt och vet vad du ska öva på."
          }
        }
      },
      "comment": "A157: English by Angela Fable, for Kelly's review (Ke86)."
    },
    "Då visas prov från din skola först. Det sparas bara på telefonen.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Then quizzes from your school are shown first. It is only saved on your phone."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Då visas prov från din skola först. Det sparas bara på telefonen."
          }
        }
      },
      "comment": "A157: English by Angela Fable, for Kelly's review (Ke86)."
    },
    "EarMind": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "EarMind"
          }
        }
      }
    },
    "EarMind behöver internet för att svara. Den fortsätter lyssna och svarar igen när du är uppkopplad.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "EarMind needs internet to answer. It keeps listening and answers again when you're online."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "EarMind behöver internet för att svara. Den fortsätter lyssna och svarar igen när du är uppkopplad."
          }
        }
      },
      "comment": "A157: English by Angela Fable, for Kelly's review (Ke86)."
    },
    "EarMind börjar lyssna i %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "EarMind starts listening in %@"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "EarMind börjar lyssna i %@"
          }
        }
      },
      "comment": "A157: English by Angela Fable, for Kelly's review (Ke86)."
    },
    "EarMind börjar med det du behöver öva på": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "EarMind starts with what you need to practise"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "EarMind börjar med det du behöver öva på"
          }
        }
      },
      "comment": "A157: English by Angela Fable, for Kelly's review (Ke86)."
    },
    "EarMind börjar om som ny på den här telefonen.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "EarMind starts over as new on this phone."
          }
        },
