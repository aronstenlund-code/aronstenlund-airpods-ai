        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Veckokortet kostar %@ i veckan och förnyas automatiskt tills du säger upp det, senast 24 timmar före nästa vecka. "
          }
        }
      },
      "comment": "A157: English by Angela Fable, for Kelly's review (Ke86)."
    },
