    "Socker och syre bildas av koldioxid och vatten med hjälp av ljus.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sugar and oxygen are formed from carbon dioxide and water with the help of light."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Socker och syre bildas av koldioxid och vatten med hjälp av ljus."
          }
        }
      },
      "comment": "A157: English by Angela Fable, for Kelly's review (Ke86)."
    },
    "Sockret ger växten energi och byggmaterial, och syret släpps ut och används av djur och människor i cellandningen.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "The sugar gives the plant energy and building material, and the oxygen is released and used by animals and people in cellular respiration."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sockret ger växten energi och byggmaterial, och syret släpps ut och används av djur och människor i cellandningen."
          }
        }
      },
      "comment": "A157: English by Angela Fable, for Kelly's review (Ke86)."
    },
    "Som Siri, fast den förstår vad du frågar och svarar direkt i dina AirPods.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Like Siri, except it understands what you ask and answers right in your AirPods."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Som Siri, fast den förstår vad du frågar och svarar direkt i dina AirPods."
          }
        }
      },
      "comment": "A157: English by Angela Fable, for Kelly's review (Ke86)."
    },
