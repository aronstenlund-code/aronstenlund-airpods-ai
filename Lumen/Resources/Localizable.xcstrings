    "Hands-free: speak, pause, get a tutor-style answer, continue. Talking while it speaks interrupts it. Tuned on device.": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Handsfree: prata, pausa, få ett lärarsvar, fortsätt. Pratar du medan den talar avbryts den. Finjusteras på enhet."
          }
        }
      }
    },
