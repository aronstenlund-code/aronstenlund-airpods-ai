    "Provet skickas till EarMinds server för att läsas en gång, och bara frågorna sparas, på den här telefonen. Saknas facit skriver EarMind egna svar och säger det.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "The paper is sent to EarMind's server to be read once, and only the questions are saved, on this phone. If there is no answer key, EarMind writes its own answers and says so."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Provet skickas till EarMinds server för att läsas en gång, och bara frågorna sparas, på den här telefonen. Saknas facit skriver EarMind egna svar och säger det."
          }
        }
      },
      "comment": "A157: English by Angela Fable, for Kelly's review (Ke86)."
    },
