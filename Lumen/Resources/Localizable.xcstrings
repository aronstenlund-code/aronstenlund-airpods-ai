    "1. Tryck Nytt prov.\n2. Tryck Fota sidor och fota alla sidor i följd.\n3. Tryck Skapa frågor.\n4. Kolla sammanfattningen och tryck Ser rätt ut.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "1. Tap New quiz.\n2. Tap Take photos and photograph all the pages in order.\n3. Tap Create questions.\n4. Check the summary and tap Looks right."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Tryck Nytt prov.\n2. Tryck Fota sidor och fota alla sidor i följd.\n3. Tryck Skapa frågor.\n4. Kolla sammanfattningen och tryck Ser rätt ut."
          }
        }
      },
      "comment": "A157: English by Angela Fable, for Kelly's review (Ke86)."
    },
    "A call or another app interrupted the session.": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett samtal eller en annan app avbröt sessionen."
