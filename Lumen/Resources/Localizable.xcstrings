    "Auto listens for questions in the room. Hold to ask gives the fewest false answers.": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto lyssnar efter frågor i rummet. Håll för att fråga ger minst felaktiga svar."
          }
        }
      }
    },
