    "Testläget är på: ljudet skickas till oss och sparas i 14 dagar. Sömnläget sparar klippen bara på din telefon.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Test mode is on: the audio is sent to us and saved for 14 days. Sleep mode keeps its clips only on your phone."
