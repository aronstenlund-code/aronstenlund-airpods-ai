    "It listens only while a session is on": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lyssnar bara när du har startat en session"
          }
        }
      }
    },
    "Key terms are extracted on this iPhone and help speech recognition and answers. The text itself never leaves the phone; only the terms (max 30) are sent with a question.": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyckeltermer tas fram på den här telefonen och hjälper taligenkänningen och svaren. Själva texten lämnar aldrig telefonen; bara termerna (max 30) skickas med en fråga."
          }
        }
      }
    },
    "Language": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Språk"
          }
        }
      }
    },
